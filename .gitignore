# ==============================================================================
# Unity .gitignore
# Standard Git ignore rules for Unity projects
# ==============================================================================

# Unity build caches, logs, and temporary directories
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
/[Mm]emoryCaptures/
/[Rr]ecordings/

# Autogenerated IDE plugins and cache directories
/[Aa]ssets/Plugins/Editor/JetBrains*
.vs/
.idea/
.vscode/
.gradle/
ExportedObj/
.consulo/

# Autogenerated Solution, Project, and Cache files
*.csproj
*.unityproj
*.sln
*.slnx
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# Unity3D generated debug and symbol meta files
*.pidb.meta
*.pdb.meta
*.mdb.meta

# Unity crash reports & diagnostics
sysinfo.txt
crashlytics-build.properties

# Build outputs
*.apk
*.aab
*.unitypackage
*.app

# OS Generated Artifacts
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini

# Strictly preserve critical Unity project asset & configuration directories
!/[Aa]ssets/
!/[Pp]ackages/
!/[Pp]roject[Ss]ettings/
